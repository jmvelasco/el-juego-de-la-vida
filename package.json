{
  "name": "el-juego-de-la-vida",
  "version": "1.0.0",
  "description": "El Juego de la Vida",
  "scripts": {
    "prepare": "husky install",
    "dev": "tsc --watch",
    "dev:ui": "npm-run-all --parallel build:ui:watch serve",
    "build:ui": "esbuild src/index.tsx --bundle --outfile=dist/bundle.js",
    "build:ui:watch": "npm run build:ui -- --watch",
    "serve": "live-server --port=3000 --entry-file=index.html",
    "build": "npm run clean && tsc -b",
    "clean": "rm -rf lib coverage",
    "analyze": "npm run lint:fix && npm run compile",
    "compile": "tsc --noEmit",
    "compile:watch": "tsc --noEmit --watch",
    "compile:build": "tsc -b",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "lint-staged": "lint-staged",
    "lint-staged:debug": "lint-staged --debug",
    "format": "prettier --config .prettierrc '**/*.+(ts|tsx)'",
    "format:check": "prettier --config .prettierrc \"**/*.+(ts|tsx)\" --check",
    "format:fix": "prettier --config .prettierrc \"**/*.+(ts|tsx)\" --write",
    "test": "jest --verbose",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "validate": "npm run compile && npm run lint && npm run test",
    "upgrade": "ncu -i",
    "upgrade:all": "ncu -u"
  },
  "author": "El Artesano del Byte",
  "license": "MIT",
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/jest": "30.0.0",
    "@types/node": "24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "8.48.1",
    "@typescript-eslint/parser": "8.48.1",
    "esbuild": "^0.27.2",
    "eslint": "9.39.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.4",
    "husky": "9.1.7",
    "jest": "30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "lint-staged": "16.2.7",
    "live-server": "^1.2.2",
    "npm-check-updates": "19.1.2",
    "npm-run-all": "^4.1.5",
    "prettier": "3.7.4",
    "ts-jest": "29.4.6",
    "typescript": "5.9.3"
  },
  "lint-staged": {
    "*.+(ts|tsx)": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  }
}